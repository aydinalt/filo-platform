NODE_ENV=development
# Production startup requires HTTPS WEB_ORIGIN, COOKIE_SECURE=true, DATABASE_URL,
# and unique non-placeholder values for all three secrets below.
PORT=3001
TRUST_PROXY_HOPS=0
REQUEST_BODY_LIMIT_BYTES=1048576
REQUEST_TIMEOUT_MS=15000
WEB_ORIGIN=http://localhost:5173
DATABASE_ADMIN_URL=postgresql://filo:filo_dev_password@localhost:5432/filo
DATABASE_URL=postgresql://filo_app:filo_app_dev_password@localhost:5432/filo
SESSION_SECRET=replace-with-at-least-32-random-characters
NOTIFICATION_WORKER_KEY=replace-with-at-least-32-random-characters
NOTIFICATION_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
# Provider credentials are referenced by variable name in the database; values stay here.
# FILO_EMAIL_PROVIDER_KEY=
# FILO_PUSH_PROVIDER_KEY=
SESSION_TTL_HOURS=12
COOKIE_SECURE=false
VITE_API_URL=http://localhost:3001
