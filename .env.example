# Environment identity. Every environment must use different data, storage and provider resources.
APP_ENV=development
ENVIRONMENT_ID=filo-development
PUBLIC_APP_ORIGIN=http://localhost:3000
RELEASE_VERSION=1.28.20
D1_ENVIRONMENT_ID=filo-development-d1
R2_ENVIRONMENT_ID=filo-development-r2
SECRETS_ROTATED_AT=
SECRET_ROTATION_OWNER=
SECRET_MAX_AGE_DAYS=90

# Public enrollment remains closed until every legal field is real and reviewed.
LEGAL_CONTROLLER_NAME=
LEGAL_CONTROLLER_EMAIL=
LEGAL_CONTROLLER_ADDRESS=
LEGAL_TERMS_EFFECTIVE_AT=
PUBLIC_SIGNUP_ENABLED=false
PRIVILEGED_MFA_REQUIRED=true
BROWSER_TELEMETRY_ENABLED=false

# Messaging and notification providers
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_FROM=
EXPO_ACCESS_TOKEN=
EXPO_PROJECT_ID=
FCM_SERVER_KEY=

# Payment, signature and e-invoice providers
PAYMENT_API_KEY=
PAYMENT_API_URL=
PAYMENT_PROVIDER_NAME=
PAYMENT_WEBHOOK_SECRET=
ESIGN_API_KEY=
ESIGN_WEBHOOK_SECRET=
EINVOICE_API_KEY=
EINVOICE_API_URL=
EINVOICE_PROVIDER_NAME=
EINVOICE_WEBHOOK_SECRET=

# Scheduled operations and fail-closed file scanning
OPERATIONS_CRON_SECRET=
OPERATIONS_ALERT_EMAILS=
DATABASE_CAPACITY_USED_PERCENT=
STORAGE_CAPACITY_USED_PERCENT=
MALWARE_SCAN_PROVIDER=
CLOUDMERSIVE_API_KEY=

# Global VIN/OEM catalog adapter
VEHICLE_CATALOG_PROVIDER=
VEHICLE_CATALOG_API_URL=
VEHICLE_CATALOG_API_KEY=
VEHICLE_CATALOG_ALLOWED_HOSTS=

# Physical tracker gateways use per-device tokens stored hashed in the active database.
TRACKER_GATEWAY_MODE=DEVICE_TOKEN
DEVICE_TOKEN_MAX_AGE_DAYS=30

# Current embedded map provider and exact CSP/data-flow allowlist.
MAP_PROVIDER=OPENSTREETMAP
MAP_ALLOWED_HOSTS=www.openstreetmap.org,tile.openstreetmap.org

# Vercel + Supabase deployment. Leave FILO_RUNTIME unset on Sites/Cloudflare.
FILO_RUNTIME=supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DATABASE_URL=
SUPABASE_STORAGE_BUCKET=filo-private
SUPABASE_POOL_SIZE=5
SUPABASE_CRON_MODE=PG_CRON

# Supabase Auth production evidence. Configure the same values in Auth settings.
SUPABASE_AUTH_SITE_URL=
SUPABASE_AUTH_ALLOWED_REDIRECTS=
SUPABASE_AUTH_EMAIL_CONFIRMATION_REQUIRED=true
SUPABASE_AUTH_CUSTOM_SMTP_ENABLED=true
SUPABASE_AUTH_CAPTCHA_ENABLED=true
SUPABASE_AUTH_RATE_LIMIT_EMAILS_PER_HOUR=30
SUPABASE_AUTH_PASSWORD_MIN_LENGTH=10
NEXT_PUBLIC_SUPABASE_REQUIRE_CAPTCHA=true
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Platform operator allowlist. Tenant administrators do not receive this access.
PLATFORM_ADMIN_EMAILS=
