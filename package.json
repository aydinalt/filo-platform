{
  "name": "filo-platform",
  "version": "1.28.20",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-tool.mjs vite",
    "build": "node scripts/build-verified.mjs",
    "build:vercel": "next build",
    "start": "node scripts/run-tool.mjs vinext start",
    "test": "npm run build && node --test",
    "typecheck": "node scripts/typecheck.mjs",
    "security:scan": "node scripts/release-security-check.mjs",
    "migration:lint": "node scripts/migration-lint.mjs",
    "sbom": "node scripts/generate-sbom.mjs",
    "release:manifest": "node scripts/release-manifest.mjs",
    "release:package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-release.ps1",
    "build:reproducible": "node scripts/reproducible-build-check.mjs",
    "gates:4-15": "node scripts/validate-release-gates.mjs",
    "gates:4-15:go-live": "node scripts/validate-release-gates.mjs --go-live",
    "capacity:verify": "node scripts/validate-capacity-budget.mjs",
    "readiness:final": "node scripts/validate-final-production-readiness.mjs",
    "readiness:final:strict": "node scripts/validate-final-production-readiness.mjs --strict",
    "technical:readiness": "node scripts/technical-go-live-audit.mjs",
    "technical:readiness:strict": "node scripts/technical-go-live-audit.mjs --strict",
    "synthetic:production": "node scripts/synthetic-production-check.mjs",
    "ci:verify": "node scripts/ci-verify.mjs",
    "preflight:production": "node scripts/production-preflight.mjs",
    "preflight:production:json": "node scripts/production-preflight.mjs --json",
    "preflight:production:strict": "node scripts/production-preflight.mjs --strict",
    "hardware:gateway:evidence:verify": "node scripts/validate-hardware-gateway-evidence.mjs --strict",
    "mobile:field:evidence:verify": "node scripts/validate-mobile-field-evidence.mjs --strict",
    "validate:artifact": "node scripts/validate-artifact.mjs",
    "lint": "node scripts/run-tool.mjs eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "node scripts/run-tool.mjs drizzle-kit generate",
    "supabase:migration": "node scripts/generate-supabase-migration.mjs",
    "supabase:apply": "node scripts/supabase-deploy.mjs --apply",
    "supabase:verify": "node scripts/supabase-deploy.mjs",
    "supabase:runtime:test": "node scripts/supabase-runtime-integration.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.114.0",
    "drizzle-orm": "0.45.2",
    "next": "^16.3.4",
    "postgres": "^3.4.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.3",
    "@cloudflare/workers-types": "^5.20260902.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.4",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "^1.0.0-beta.8",
    "vite": "^8.2.2",
    "wrangler": "^4.128.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "type": "module"
}
